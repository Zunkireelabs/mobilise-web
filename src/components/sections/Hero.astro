---
// Markup ported verbatim from index2.html's #hero section (already
// Mobiise-specific content/copy there — only CSS/classes are reused).
import { getIcon } from '@utils/icon';

const arrowIcon = getIcon('arrow-up-right');
---

<section class="mb-hero" id="hero">
  <div class="mb-rail-lines" aria-hidden="true"></div>
  <svg
    class="mb-map"
    id="mb-map"
    viewBox="0 0 840 324"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  ></svg>
  <div class="mb-hh column" data-astro-cid-5lyysmr3>
    <h1>MOBILISE Makes<br />Global Integrated<br />Marketing Interesting</h1>
    <div class="mb-hc">
      <p>
        The independent B2B marketing agency for enterprise brands. Global standards, regional
        fluency — at speed.
      </p>
      <div class="mb-bt">
        <a class="mb-b2" href="/contact">
          Connect with us <b>+</b>
          <span class="button__arrow" set:html={arrowIcon} />
        </a>
        <a class="mb-b2 mb-s" href="#about">Who we are <b>+</b></a>
      </div>
    </div>
  </div>
  <div class="mb-logos column" id="mb-logos" data-astro-cid-5lyysmr3></div>
</section>

<script>
  import { initHeroLogos, initHeroMap } from '@scripts/hero';

  initHeroLogos();
  initHeroMap();
</script>
