---
// Migrated from src/data/section-testimonials.html (raw HTML via
// RawSection) to a real Astro component: the 6 testimonial cards
// collapsed into a typed data array + a loop instead of 6 hand-copied
// <article> blocks. No CSS to port here — .tcar* styles already live as
// plain (unscoped) CSS in global.css (added when the carousel was built,
// not part of the original scrape). The drag-snap carousel script (real,
// working behavior: clone-peek cards, dots, prev/next, autoplay,
// prefers-reduced-motion) is ported as-is into this component's own
// <script>, same spot it lived in the raw HTML.
interface Testimonial {
  photo: string;
  logo: string;
  logoRound?: boolean;
  logoAlt: string;
  quote: string;
  caption: string;
  ctaHref: string;
  ctaLabel: string;
}

const testimonials: Testimonial[] = [
  {
    photo: '/images/testimonials/photo-redhat-1.jpg',
    logo: '/images/testimonials/testimonials_redhat.png',
    logoAlt: 'Red Hat',
    quote:
      '"Thank you for your quick responses and turnaround. The entire AMER team are all very keen on having our creative support undertaken by MOBILISE, of course!"',
    caption: 'Global Customer Success Leader – Red Hat',
    ctaHref: '/case-studies',
    ctaLabel: 'See full announcement',
  },
  {
    photo: '/images/testimonials/photo-salesforce.jpg',
    logo: '/images/testimonials/testimonials_salesforce.png',
    logoAlt: 'Salesforce',
    quote:
      '"You are our superstar APAC creative team, and I speak for the entire AMER creative leadership. Best partners any brand could ask for - you guys are absolute champions!"',
    caption: 'Global Brand and Campaigns Lead – Salesforce',
    ctaHref: '/blog',
    ctaLabel: 'See full post',
  },
  {
    photo: '/images/testimonials/photo-hp.jpg',
    logo: '/images/testimonials/testimonials_hp.png',
    logoRound: true,
    logoAlt: 'HP',
    quote: '"Really appreciate your support on our campaigns. Awesome work at superfast TAT! Our global stakeholders are your fans."',
    caption: 'Head of WW Studio – HP',
    ctaHref: '/case-studies',
    ctaLabel: 'See full post',
  },
  {
    photo: '/images/testimonials/photo-elastic.jpg',
    logo: '/images/logo-elastic.png',
    logoAlt: 'Elastic',
    quote:
      '"I have not seen an agency so bent on innovating and thinking out of the box. You are the human form of GenAI - input a prompt, give parameters, and poof, you deliver everything magically!"',
    caption: 'Head of Strategy, APJ Marketing – Elastic',
    ctaHref: '/case-studies',
    ctaLabel: 'See full post',
  },
  {
    photo: '/images/testimonials/photo-redhat-2.jpg',
    logo: '/images/testimonials/testimonials_redhat.png',
    logoAlt: 'Red Hat',
    quote: '"We are the top region 5 years in a row! It has been a fantastic partnership - absolutely brilliant, creative at its best and delivered in record time."',
    caption: 'Head of Marketing, South Asia – Red Hat',
    ctaHref: '/case-studies',
    ctaLabel: 'See full post',
  },
  {
    photo: '/images/testimonials/photo-rockwell.jpg',
    logo: '/images/testimonials/testimonials_rockwell.png',
    logoAlt: 'Rockwell Automation',
    quote: '"I wanted to express my sincere gratitude for the incredible work you\'ve done for us. The leadership team calls it the best marketing to date!"',
    caption: 'Marketing Lead, Australia – Rockwell Automation',
    ctaHref: '/case-studies',
    ctaLabel: 'See full post',
  },
];
---

<section aria-label="What people say" class="tcar" data-section="testimonials" id="testimonials">
  <div class="tcar__column">
    <div class="tcar__head" data-motion-rise>
      <div class="tcar__head-text">
        <p class="eyebrow eyebrow--accent" data-astro-cid-zedojbgr>
          <span aria-hidden="true" class="eyebrow__mark" data-astro-cid-zedojbgr></span>Testimonials
        </p>
        <h2 class="text text--h2 tone--heading weight--300" data-astro-cid-io6xibmp>What people say</h2>
      </div>
      <a class="tcar__all" href="/case-studies">
        <span>View all case studies</span>
        <svg aria-hidden="true" class="icon" fill="currentColor" focusable="false" height="16" viewBox="0 0 256 256" width="16" xmlns="http://www.w3.org/2000/svg">
          <path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z" />
        </svg>
      </a>
    </div>
    <div class="tcar__rail-frame">
      <div aria-hidden="true" class="tcar__fade tcar__fade--left" />
      <div aria-hidden="true" class="tcar__fade tcar__fade--right" />
      <div class="tcar__rail" data-tcar-rail>
        {
          testimonials.map((t) => (
            <article class="tcar__card" data-tcar-card>
              <span aria-hidden="true" class="tcar__corner tcar__corner--tl" />
              <span aria-hidden="true" class="tcar__corner tcar__corner--tr" />
              <span aria-hidden="true" class="tcar__corner tcar__corner--bl" />
              <span aria-hidden="true" class="tcar__corner tcar__corner--br" />
              <div class="tcar__media">
                <img alt="" class="tcar__photo" decoding="async" height="1031" loading="lazy" src={t.photo} width="1600" />
                <div aria-hidden="true" class="tcar__scrim" />
                <img
                  alt={t.logoAlt}
                  class={`tcar__logo${t.logoRound ? ' tcar__logo--round' : ''}`}
                  decoding="async"
                  height="213"
                  loading="lazy"
                  src={t.logo}
                  width="1127"
                />
              </div>
              <div class="tcar__info">
                <div class="tcar__text">
                  <blockquote class="tcar__quote">{t.quote}</blockquote>
                  <p class="tcar__caption">{t.caption}</p>
                </div>
                <a class="tcar__cta" href={t.ctaHref}>
                  <span>{t.ctaLabel}</span>
                  <svg aria-hidden="true" class="icon" fill="currentColor" focusable="false" height="12" viewBox="0 0 256 256" width="12" xmlns="http://www.w3.org/2000/svg">
                    <path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z" />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <div class="tcar__nav">
        <button aria-label="Previous testimonial" class="tcar__arrow tcar__arrow--prev" data-tcar-prev type="button">
          <svg aria-hidden="true" class="icon" fill="none" height="20" viewBox="0 0 24 24" width="20" xmlns="http://www.w3.org/2000/svg">
            <line stroke="currentColor" stroke-linecap="round" stroke-width="1.6" x1="20" x2="4" y1="12" y2="12" />
            <polyline fill="none" points="10 6 4 12 10 18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" />
          </svg>
        </button>
        <div class="tcar__dots" data-tcar-dots />
        <button aria-label="Next testimonial" class="tcar__arrow tcar__arrow--next" data-tcar-next type="button">
          <svg aria-hidden="true" class="icon" fill="none" height="20" viewBox="0 0 24 24" width="20" xmlns="http://www.w3.org/2000/svg">
            <line stroke="currentColor" stroke-linecap="round" stroke-width="1.6" x1="4" x2="20" y1="12" y2="12" />
            <polyline fill="none" points="14 6 20 12 14 18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('testimonials');
    if (!section) return;
    var rail = section.querySelector('[data-tcar-rail]') as HTMLElement | null;
    var realCards = Array.prototype.slice.call(section.querySelectorAll('[data-tcar-card]')) as HTMLElement[];
    if (!rail || !realCards.length) return;

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Clone the last/first real card into non-interactive peek slides at each
    // end, so the first and last real cards also get a neighbor to peek at
    // instead of a dead gap (see DOM order: [clone, ...real, clone]).
    var leadClone = realCards[realCards.length - 1].cloneNode(true) as HTMLElement;
    var tailClone = realCards[0].cloneNode(true) as HTMLElement;
    [leadClone, tailClone].forEach(function (clone) {
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('inert', '');
      clone.removeAttribute('data-tcar-card');
    });
    rail.insertBefore(leadClone, realCards[0]);
    rail.appendChild(tailClone);

    var dotsWrap = section.querySelector('[data-tcar-dots]') as HTMLElement;
    var dots = realCards.map(function (_, i) {
      var dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'tcar__dot';
      dot.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));
      dotsWrap.appendChild(dot);
      return dot;
    });

    function goTo(index: number) {
      index = Math.max(0, Math.min(realCards.length - 1, index));
      var card = realCards[index];
      var target = card.offsetLeft + card.offsetWidth / 2 - (rail as HTMLElement).clientWidth / 2;
      (rail as HTMLElement).scrollTo({
        left: target,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    }

    function activeIndex() {
      var center = (rail as HTMLElement).scrollLeft + (rail as HTMLElement).clientWidth / 2;
      var closest = 0;
      var min = Infinity;
      realCards.forEach(function (card, i) {
        var mid = card.offsetLeft + card.offsetWidth / 2;
        var d = Math.abs(mid - center);
        if (d < min) {
          min = d;
          closest = i;
        }
      });
      return closest;
    }

    function syncActive() {
      var current = activeIndex();
      realCards.forEach(function (card, i) {
        card.classList.toggle('is-active', i === current);
      });
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === current);
        dot.setAttribute('aria-current', i === current ? 'true' : 'false');
      });
    }

    rail.addEventListener(
      'scroll',
      function () {
        window.requestAnimationFrame(syncActive);
      },
      { passive: true }
    );

    section.querySelector('[data-tcar-prev]')?.addEventListener('click', function () {
      goTo(activeIndex() - 1);
      restartAutoplay();
    });
    section.querySelector('[data-tcar-next]')?.addEventListener('click', function () {
      goTo(activeIndex() + 1);
      restartAutoplay();
    });
    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        goTo(i);
        restartAutoplay();
      });
    });

    // Automatic slideshow — advances one card at a time, loops back to the
    // start after the last one. Paused on hover/focus (and never started at
    // all under prefers-reduced-motion) so it never fights a reading user.
    var AUTOPLAY_DELAY = 5000;
    var autoplayTimer: number | null = null;

    function stepAutoplay() {
      var next = activeIndex() + 1;
      goTo(next > realCards.length - 1 ? 0 : next);
    }

    function startAutoplay() {
      if (reduceMotion) return;
      stopAutoplay();
      autoplayTimer = window.setInterval(stepAutoplay, AUTOPLAY_DELAY);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        window.clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function restartAutoplay() {
      if (reduceMotion) return;
      startAutoplay();
    }

    var railFrame = section!.querySelector('.tcar__rail-frame') as HTMLElement;
    ['pointerenter', 'focusin'].forEach(function (evt) {
      railFrame.addEventListener(evt, stopAutoplay);
    });
    ['pointerleave', 'focusout'].forEach(function (evt) {
      railFrame.addEventListener(evt, startAutoplay);
    });
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });

    goTo(0);
    syncActive();
    startAutoplay();
  })();
</script>
