  <div class="column services__column" data-astro-cid-5lyysmr3>
    <div class="services__heading" data-motion-rise>
      <p class="eyebrow eyebrow--accent" data-astro-cid-zedojbgr>
        <span aria-hidden="true" class="eyebrow__mark" data-astro-cid-zedojbgr></span>
        One System, Every Deliverable
      </p>
      <h2 class="text text--h2 tone--heading weight--300" data-astro-cid-io6xibmp>
        One agency, every function
      </h2>
    </div>

    <div class="services__layout">
      <nav class="services__rail" aria-label="Jump to service">
        <ul>
          {
            services.map((service) => (
              <li>
                <a href={`#${service.slug}`} data-rail-link data-rail-target={service.slug}>
                  <span class="services__rail-bullet" aria-hidden="true" />
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="services__cards">
        {
          services.map((service, i) => (
            <article
              class="services__card"
              id={service.slug}
              data-service-card={service.slug}
              data-motion-rise
              style={`z-index: ${i + 1}`}
            >
              <div class="services__card-content">
                <h2 class="text text--card-title weight--400 tone--heading" data-astro-cid-io6xibmp>
                  {service.title}
                </h2>
                <p class="text text--body-lg tone--secondary" data-astro-cid-io6xibmp>
                  {service.description}
                </p>
                <a class="services__explore" href={`/services/${service.slug}`}>
                  Explore {service.title}
                  <span class="services__explore-icon" set:html={arrowIcon} />
                </a>

                <div class="services__divider" aria-hidden="true" />

                <ul class="services__chips">
                  {service.offerings.map((offering) => (
                    <li>
                      <a class="services__chip" href={offering.href}>
                        <span class="services__chip-icon" set:html={getIcon(offering.icon)} />
                        <span class="services__chip-label">{offering.label}</span>
                        <span class="services__chip-arrow" set:html={arrowIcon} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="services__visual" data-tint={service.index}>
                <img
                  class="services__visual-image"
                  src={service.image}
                  alt={service.imageAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  width="960"
                  height="720"
