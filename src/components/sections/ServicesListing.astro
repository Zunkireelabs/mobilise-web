<Close />

<script>
  (function () {
    const rail = document.querySelector<HTMLElement>('.services__rail');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-service-card]'));
    if (!rail || !cards.length) return;

    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
    const linkByTarget = new Map(links.map((link) => [link.dataset.railTarget, link]));

    function setActive(slug: string | undefined) {
      if (!slug) return;
      links.forEach((link) => link.removeAttribute('data-active'));
      linkByTarget.get(slug)?.setAttribute('data-active', '');
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActive((visible.target as HTMLElement).dataset.serviceCard);
      },
      { rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    cards.forEach((card) => observer.observe(card));
    setActive(cards[0]?.dataset.serviceCard);
  })();
</script>

<style>
  .services__column {
    /* Matches the sitewide gutter+24px content inset (see global.css's
       .mb-hh.column comment / Industries.astro's .proof__column) — the bare
       .column gutter alone reads as flush/under-padded next to every other
       section. */
    padding-inline: calc(var(--gutter, 40px) + var(--space-6, 24px));
    display: flex;
    flex-direction: column;
    gap: var(--space-20, 5rem);
  }

  .services__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }
  .services__heading .eyebrow {
    justify-content: center;
  }
  .services__heading h2 {
    margin: 0;
  }

  .services-hero__column {
    /* Same gutter+24px fix as Hero.astro's .mb-hh.column — see global.css. */
    padding-inline: calc(var(--gutter, 40px) + var(--space-6, 24px));
    display: flex;
    flex-direction: column;
    gap: var(--space-16, 4rem);
  }

  .services-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-10, 2.5rem);
    align-items: center;
  }

  .services-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5, 1.25rem);
  }
  .services-hero__copy h1,
  .services-hero__copy p {
    margin: 0;
  }
  .services-hero__copy .text--lead {
    max-width: 42ch;
  }

  .services-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3, 0.75rem);
    margin-block-start: var(--space-2, 0.5rem);
  }

  .services-hero__visual {
    position: relative;
    aspect-ratio: 5 / 6;
    background: var(--color-accent-surface, #e6f1ef);
    border: 1px solid var(--color-canvas-line, #ffffff1f);
  }

  .services-hero__mock {
    position: absolute;
    background: #fff;
    box-shadow: 0 20px 40px rgba(4, 38, 42, 0.18);
  }
  .services-hero__mock--browser {
    top: 8%;
    right: 7%;
    width: 78%;
    aspect-ratio: 16 / 12;
    clip-path: polygon(22px 0, 100% 0, 100% 100%, 0 100%, 0 22px);
    overflow: hidden;
  }
  .services-hero__mock-frame {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }
  .services-hero__mock--phone {
    left: 6%;
    bottom: 6%;
    width: 32%;
    aspect-ratio: 9 / 17;
    clip-path: polygon(14px 0, 100% 0, 100% 100%, 0 100%, 0 14px);
    display: flex;
    flex-direction: column;
    padding: 10% 9%;
    gap: 10%;
    z-index: 1;
  }

  .services-hero__mock-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5% 6%;
    border-block-end: 1px solid var(--color-border, #0b42471f);
  }
  .services-hero__mock-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-border-strong, #0b42473d);
  }
  .services-hero__mock-url {
    margin-inline-start: 8%;
    flex: 1;
    max-width: 55%;
    height: 10px;
    border-radius: 999px;
    background: var(--color-accent-surface, #e6f1ef);
  }

  .services-hero__mock-body {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    padding: 7% 7%;
    overflow: hidden;
  }
  .services-hero__mock-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 12%;
    width: 60%;
  }
  .services-hero__mock-line {
    display: block;
    overflow: hidden;
    color: var(--color-secondary, #1f5257);
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .services-hero__mock-line b {
    color: var(--color-heading, #0b4247);
    font-weight: 600;
  }
  .services-hero__mock-line--title {
    color: var(--color-heading, #0b4247);
    font-size: 14px;
    font-weight: 600;
    opacity: 0.85;
  }
  .services-hero__mock-line--short {
    width: 70%;
  }
  .services-hero__mock-pill {
    width: fit-content;
    border-radius: 999px;
    background: var(--accent-400, #34a0a2);
    color: #fff;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 4px 10px;
    margin-block-start: 6%;
    align-items: center;
    display: flex;
  }
  .services-hero__mock-arc {
    position: absolute;
    right: -10%;
    bottom: -20%;
    width: 65%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent-surface, #e6f1ef);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    display: flex;
  }
  .services-hero__mock-arc::after {
    content: '';
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: #fff;
    z-index: 0;
  }
  .services-hero__mock-arc b,
  .services-hero__mock-arc small {
    position: relative;
    z-index: 1;
  }
  .services-hero__mock-arc b {
    color: var(--color-heading, #0b4247);
    font-size: 15px;
    font-weight: 600;
  }
  .services-hero__mock-arc small {
    color: var(--color-secondary, #1f5257);
    font-size: 8px;
  }

  .services-hero__mock-stats {
    display: flex;
    gap: 6%;
    padding: 0 7% 8%;
  }
  .services-hero__mock-stat {
    flex: 1;
    border-radius: 6px;
    background: var(--color-accent-surface, #e6f1ef);
    padding: 5px 4px;
    flex-direction: column;
    align-items: center;
    display: flex;
  }
  .services-hero__mock-stat b {
    color: var(--color-heading, #0b4247);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
  }
  .services-hero__mock-stat small {
    color: var(--color-secondary, #1f5257);
    font-size: 7px;
    line-height: 1.2;
  }

  .services-hero__mock-avatar {
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent-400, #34a0a2);
  }
  .services-hero__mock--phone .services-hero__mock-line--title {
    width: 80%;
    font-size: 11px;
    white-space: normal;
  }
  .services-hero__mock-media {
    flex: 1;
    border-radius: 6px;
    background: var(--color-accent-surface, #e6f1ef);
  }
  .services-hero__mock--phone .services-hero__mock-pill {
    width: fit-content;
    margin-block-start: 0;
  }

  /* Reveal the mockup's content piece by piece once the hero's existing
     data-motion-rise/[data-motion-in] toggle (src/scripts/motion.ts) fires
     on .services-hero__layout — same ancestor-driven pattern as
     .wwa__visual[data-motion-in] .wwa__arrow in global.css, not a new
     observer. Each element's --d (set inline in the markup) staggers it
     within that single reveal instead of adding more data-motion-rise
     targets, which would also push back .services-hero__stats' delay. */
  .services-hero__mock-line,
  .services-hero__mock-pill,
  .services-hero__mock-arc,
  .services-hero__mock-stat,
  .services-hero__mock-avatar,
  .services-hero__mock-media {
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.5s var(--ease-rise, cubic-bezier(0.22, 1, 0.36, 1)),
      translate 0.5s var(--ease-rise, cubic-bezier(0.22, 1, 0.36, 1));
    transition-delay: var(--d, 0s);
  }
  .services-hero__mock-arc {
    translate: 0 14px;
  }
  .services-hero__layout[data-motion-in] .services-hero__mock-line,
  .services-hero__layout[data-motion-in] .services-hero__mock-pill,
  .services-hero__layout[data-motion-in] .services-hero__mock-arc,
  .services-hero__layout[data-motion-in] .services-hero__mock-stat,
  .services-hero__layout[data-motion-in] .services-hero__mock-avatar,
  .services-hero__layout[data-motion-in] .services-hero__mock-media {
    opacity: 1;
