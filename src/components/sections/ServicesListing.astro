---
// Services page: a dark canvas hero (structure adapted from
// buildops.com/platform's own hero — eyebrow, display heading, lead copy,
// two CTAs, visual panel, stat-proof row) followed by "One agency, every
// function" — the stacking-card section adapted from that same page's "A
// single operating backbone" (sticky nav rail, split content/visual cards,
// feature-chip grid). Per DESIGN_ORCHESTRATOR.md's reference principle:
// MOBILISE's own tokens/type/motion/copy throughout, not BuildOps'
// branding or wording. The hero's CTA panel is still an icon/numeral
// mock (no product screenshots to show, unlike BuildOps); the service
// card visuals below use real stock photography (src/data/services.ts
// `image`/`imageAlt`), tinted per-card to match the section's palette.
// Hero heading/CTA copy and the stat row are MOBILISE's own real
// published lines (see mobilise-website-content.md), not invented.
import { getIcon } from '@utils/icon';
import { services } from '@data/services';
import Button from '@components/Button.astro';
import Close from '@components/sections/Close.astro';

const arrowIcon = getIcon('arrow-up-right');

const industries = [
  {
    icon: 'cpu',
    label: 'Technology',
    desc: 'Unique processes for creative, audience targeting, and allocation across deep-tech products.',
  },
  {
    icon: 'cloud',
    label: 'SaaS',
    desc: 'A proven playbook, tailored to grow B2B SaaS companies through any stage of maturity.',
  },
  {
    icon: 'factory',
    label: 'Manufacturing',
    desc: 'Nuanced campaign plans designed for B2B and B2C customers across industrial segments.',
  },
];

const process = [
  {
    index: '1',
    title: 'Research',
    desc: 'Uncovers the market, audience and competitive signals that matter.',
  },
  {
    index: '2',
    title: 'Strategy',
    desc: 'Shapes one system of messaging and creative for every channel.',
  },
  {
    index: '3',
    title: 'Production',
    desc: 'Produces campaigns and content at the pace the market moves.',
  },
  {
    index: '4',
    title: 'Measurement',
    desc: "Measures what's working and moves budget to it.",
  },
];

const stats = [
  {
    value: '4',
    label: 'Global studios',
    desc: 'Teams across Bangalore, Singapore, Dubai and Seattle.',
  },
  {
    value: '+10',
    label: 'Years of word-of-mouth relationships',
    desc: 'Clients who stay — and send us the next one.',
  },
  {
    value: '10',
    label: 'Global client brands',
    desc: 'Red Hat, Salesforce, HP and more, across every region.',
  },
];
---

<section
