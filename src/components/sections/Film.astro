---
// Migrated from src/data/section-film.html (raw HTML via RawSection) to a
// real Astro component. Matching CSS moved here (scoped) from
// src/styles/reference-critical.css. See DESIGN_ORCHESTRATOR.md and the
// run-ads migration (RunAds.astro) for the established pattern:
// shared utility classes (.section, .rails) still need their original
// data-astro-cid-* attribute to match the global reference-*.css rules;
// this component's own .film* classes use Astro's real auto-scoping.
---

<section
  aria-label="MOBILISE in motion"
  class="section section--page section--rhythm-none"
  data-astro-cid-pi6vcj26
  data-section="film"
  id="film"
>
  <div class="film">
    <div aria-hidden="true" class="rails rails--ground" data-astro-cid-75uivqud></div>
    <div class="film__frame">
      <span aria-hidden="true" class="film__spine"></span>
      <video
        aria-hidden="true"
        class="film__media"
        data-film
        data-motion-rise
        loop
        muted
        autoplay
        playsinline
        preload="auto"
        tabindex="-1"
      >
        <source media="(max-width: 809px) and (orientation: portrait)" src="/video/who-we-are.mp4" type="video/mp4" />
        <source src="/video/who-we-are.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style>
  .film__frame {
    aspect-ratio: 1920 / 1014;
    isolation: isolate;
    max-inline-size: var(--rail-measure);
    margin-inline: auto;
    position: relative;
  }
  .film__frame::before,
  .film__frame::after {
    background: var(--color-border);
    content: '';
    z-index: 1;
    inline-size: 1px;
    position: absolute;
    inset-block: 0;
  }
  .film__frame::before {
    inset-inline-start: 0;
  }
  .film__frame::after {
    inset-inline-end: 0;
  }
  .film__spine {
    background: var(--color-border);
    inline-size: 1px;
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
  }
  .film__media {
    object-fit: contain;
    block-size: 100%;
    inline-size: 100%;
    display: block;
    position: relative;
  }
  @media (width <= 809px) and (orientation: portrait) {
    .film__frame {
      aspect-ratio: 3 / 5;
      max-block-size: 80svh;
      inline-size: 100%;
    }
    .film__media {
      object-fit: cover;
    }
  }
</style>
