<script>
  (function () {
    const panelId = 'site-mobile-nav';
    const toggleId = 'site-nav-toggle';

    const panel = document.getElementById(panelId);
    const toggle = document.getElementById(toggleId);
    if (!panel || !toggle) return;

    const root = document.documentElement;
    const backdrop = panel.querySelector<HTMLElement>('[data-mnav-backdrop]');
    const desktop = window.matchMedia('(min-width: 1200px)');
    const FOCUSABLE = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    const isOpen = () => panel.getAttribute('data-open') === 'true';

    function ring(): HTMLElement[] {
      const items: HTMLElement[] = [toggle!];
      panel!.querySelectorAll<HTMLElement>(FOCUSABLE).forEach((el) => {
        if (el !== toggle && el.getClientRects().length) items.push(el);
      });
      return items;
    }

    function lockScroll() {
      root.style.setProperty('--mnav-scrollbar', window.innerWidth - root.clientWidth + 'px');
      root.setAttribute('data-mnav-lock', '');
    }
    function unlockScroll() {
      root.removeAttribute('data-mnav-lock');
      root.style.removeProperty('--mnav-scrollbar');
    }

    function open() {
      if (isOpen()) return;
      panel!.removeAttribute('inert');
      panel!.setAttribute('data-open', 'true');
      toggle!.setAttribute('aria-expanded', 'true');
      lockScroll();
      ring()[1]?.focus();
    }

    function close(force = false) {
      if (!isOpen()) return;
      if (force || panel!.contains(document.activeElement)) toggle!.focus();
      panel!.setAttribute('data-open', 'false');
      panel!.setAttribute('inert', '');
      toggle!.setAttribute('aria-expanded', 'false');
      unlockScroll();
    }

    toggle.addEventListener('click', () => (isOpen() ? close(true) : open()));
    backdrop?.addEventListener('click', () => close());
    panel.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a[href]')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
        return;
      }
      if (event.key !== 'Tab') return;
      const items = ring();
      if (!items.length) return;
      event.preventDefault();
      const index = items.indexOf(document.activeElement as HTMLElement);
      const next =
        index === -1
          ? event.shiftKey
            ? items.length - 1
            : 0
          : (index + (event.shiftKey ? -1 : 1) + items.length) % items.length;
      items[next]?.focus();
    });

    desktop.addEventListener('change', (event) => {
      if (!event.matches || !isOpen()) return;
      const hadFocus = panel!.contains(document.activeElement);
      close();
      if (!hadFocus || document.activeElement === toggle) return;
      document.querySelector<HTMLElement>('.site-header__brand')?.focus();
    });
  })();
</script>

<script>
  // Desktop mega-menu interaction. The markup/CSS already has a no-JS
  // fallback (:hover / :focus-within via :has() in reference-base.css),
  // active while .nav has no [data-enhanced]. This script upgrades it to
  // click-to-toggle + hover-intent + single-open-at-a-time + Escape/
  // outside-click close, matching the reference's own data-open=true /
  // data-mega-leaving attributes that the CSS already keys off of.
  (function () {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const nav = header?.querySelector<HTMLElement>('.nav[data-nav]');
    if (!header || !nav) return;

    const LEAVE_MS = 200; // matches --duration-base: .2s
    const HOVER_OPEN_MS = 100;
    const HOVER_CLOSE_MS = 220;

    const items = Array.from(nav.querySelectorAll<HTMLElement>('.nav__item[data-nav-item]'));
    let openItem: HTMLElement | null = null;
    let hoverTimer: ReturnType<typeof setTimeout> | undefined;
    let leaveTimer: ReturnType<typeof setTimeout> | undefined;

    function triggerOf(item: HTMLElement) {
      return item.querySelector<HTMLElement>('[data-nav-trigger]');
    }
    function panelOf(item: HTMLElement) {
      return item.querySelector<HTMLElement>('.mega');
    }

    function setHeight(item: HTMLElement) {
      const inner = panelOf(item)?.querySelector<HTMLElement>('.mega__inner');
      if (inner) header!.style.setProperty('--mega-h', inner.scrollHeight + 'px');
    }

    function openPanel(item: HTMLElement) {
      clearTimeout(hoverTimer);
      clearTimeout(leaveTimer);
      if (openItem && openItem !== item) closePanel(openItem, true);
      if (item.dataset.open === 'true') return;
      setHeight(item);
      item.removeAttribute('data-mega-leaving');
      item.dataset.open = 'true';
      triggerOf(item)?.setAttribute('aria-expanded', 'true');
      openItem = item;
    }

    function closePanel(item: HTMLElement, immediate = false) {
      if (item.dataset.open !== 'true') return;
      triggerOf(item)?.setAttribute('aria-expanded', 'false');
      if (immediate) {
        delete item.dataset.open;
        item.removeAttribute('data-mega-leaving');
      } else {
        item.dataset.megaLeaving = '';
        setTimeout(() => {
          delete item.dataset.open;
          item.removeAttribute('data-mega-leaving');
        }, LEAVE_MS);
      }
      if (openItem === item) openItem = null;
    }

    function closeAll(immediate = false) {
      items.forEach((item) => closePanel(item, immediate));
    }

    items.forEach((item) => {
      const trigger = triggerOf(item);
      if (!trigger || !panelOf(item)) return;

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        if (item.dataset.open === 'true') closePanel(item);
        else openPanel(item);
      });

      item.addEventListener('mouseenter', () => {
        clearTimeout(leaveTimer);
        clearTimeout(hoverTimer);
        hoverTimer = setTimeout(() => openPanel(item), HOVER_OPEN_MS);
      });
      item.addEventListener('mouseleave', () => {
        clearTimeout(hoverTimer);
        clearTimeout(leaveTimer);
        leaveTimer = setTimeout(() => closePanel(item), HOVER_CLOSE_MS);
      });
      item.addEventListener('focusin', () => openPanel(item));
      item.addEventListener('focusout', (event) => {
        const next = (event as FocusEvent).relatedTarget as Node | null;
        if (!next || !item.contains(next)) closePanel(item);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !openItem) return;
      const item = openItem;
      closePanel(item);
      triggerOf(item)?.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      if (openItem && !openItem.contains(event.target as Node)) closeAll();
    });

    nav.setAttribute('data-enhanced', '');
  })();
</script>
