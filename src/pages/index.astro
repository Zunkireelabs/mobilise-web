---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Hero from '@components/sections/Hero.astro';
import RunAds from '@components/sections/RunAds.astro';
import Film from '@components/sections/Film.astro';
import About from '@components/sections/About.astro';
import Close from '@components/sections/Close.astro';
import Locations from '@components/sections/Locations.astro';
import CaseStudies from '@components/sections/CaseStudies.astro';
import Insights from '@components/sections/Insights.astro';
import SummitBanner from '@components/sections/SummitBanner.astro';
import Industries from '@components/sections/Industries.astro';
import Testimonials from '@components/sections/Testimonials.astro';
import Services from '@components/sections/Services.astro';
---

<BaseLayout
  title="B2B Growth Marketing & Sales Enablement | MOBILISE"
  description="MOBILISE is a global B2B marketing agency helping enterprise brands grow across APAC, EMEA and the Americas through strategy, creative and sales enablement."
>
  <Header />
  <main id="content">
    <Hero />
    <About />
    <RunAds />
    <Services />
    <Film />
    <Industries />
    <CaseStudies />
    <Testimonials />
    <SummitBanner />
    <Insights />
    <Close />
    <Locations />
  </main>
  <Footer />
</BaseLayout>
